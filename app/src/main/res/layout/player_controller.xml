<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- উপরের বার: ব্যাক + টাইটেল (নোটচ/স্ট্যাটাস বারের নিচে চাপা পড়বে না —
         PlayerActivity ইনসেট হিসাব করে এখানে প্যাডিং বসায়) -->
    <LinearLayout
        android:id="@+id/ctrlTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_bar"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="back"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/pTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- মাঝের ফাঁকা জায়গা (ভিডিও দেখা যাবে) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- নিচের কন্ট্রোল বার (নেভিগেশন বারের নিচে চাপা পড়বে না) -->
    <LinearLayout
        android:id="@+id/ctrlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_bar"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="rew"
                android:src="@android:drawable/ic_media_rew"
                app:tint="#FFFFFF" />

            <!-- ⏯ Media3-এর এক-বাটন প্লে/পজ — আইকন ও ক্লিক Media3 নিজেই সামলায়
                 (আগের exo_play/exo_pause দুই বাটন Media3 ১.২.১ চেনেই না, তাই বাটনটা মরা ছিল) -->
            <ImageButton
                android:id="@id/exo_play_pause"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="play"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="ffwd"
                android:src="@android:drawable/ic_media_ff"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPRotate"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="rotate"
                android:src="@android:drawable/ic_menu_always_landscape_portrait"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
