<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- উপরের বার: গোল ব্যাক + টাইটেল + Help + Setting (আধুনিক ইমারসিভ লুক) -->
    <LinearLayout
        android:id="@+id/ctrlTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_bar"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/player_btn_circle"
            android:contentDescription="back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/pTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_help"
            android:drawablePadding="4dp"
            android:padding="10dp"
            android:text="Help"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnSetting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="4dp"
            android:padding="10dp"
            android:text="Setting"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- মাঝের জায়গা — (v3.5) মাঝখানে ⏪10 ▶/⏸ ⏩10 ফিরে এলো (মালিকের নির্দেশ);
         ডাবল-ট্যাপ জেসচারও আগের মতোই কাজ করবে। বাটন ছাড়া জায়গা টাচ-পাসথ্রু (জেসচার আটকায় না) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPRew"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="rewind 10 seconds"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rew10"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPPlay"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginHorizontal="22dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="play or pause"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPFwd"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="forward 10 seconds"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ffwd10"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>

    <!-- নিচের কন্ট্রোল বার: সুন্দর টাইম-বার + Fit / Language / Speed চিপ-পিল -->
    <LinearLayout
        android:id="@+id/ctrlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/player_bar"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                app:bar_height="4dp"
                app:buffered_color="#55FFFFFF"
                app:played_color="#22C55E"
                app:scrubber_color="#FFFFFF"
                app:touch_target_height="30dp"
                app:unplayed_color="#66FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="46dp"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="6dp">

            <!-- ⏮ ⏭ প্রিভিয়াস/নেক্সট — সারির বাঁ দিকে (মালিকের নির্দেশ v3.6); আগের/পরেরটা না থাকলে কোড থেকে লুকানো -->
            <ImageButton
                android:id="@+id/btnPrevEp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="previous episode"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnNextEp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="next episode"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- ⛶ স্ক্রিন মোড: Fit → Zoom → Stretch -->
            <TextView
                android:id="@+id/btnMScale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/player_chip"
                android:drawableStart="@drawable/ic_fit"
                android:drawablePadding="5dp"
                android:text="Fit"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- 🎧 অডিও ট্র্যাক (ভাষা) -->
            <TextView
                android:id="@+id/btnMAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/player_chip"
                android:drawableStart="@drawable/ic_lang"
                android:drawablePadding="5dp"
                android:text="Language"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- ⚡ প্লে স্পিড -->
            <TextView
                android:id="@+id/btnMSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/player_chip"
                android:drawableStart="@drawable/ic_speed"
                android:drawablePadding="5dp"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- (v3.6) ⏭ নেক্সট বাটন সারির বাঁ দিকে সরে গেছে (উপরে) -->
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
