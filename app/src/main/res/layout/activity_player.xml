<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_controller"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="texture_view" />

    <!-- 🎛 জেসচার-পিল: 🔊 ভলিউম / ☀️ ব্রাইটনেস — উপরে-মাঝে (রেফারেন্স-প্লেয়ারের মতো) -->
    <LinearLayout
        android:id="@+id/gesturePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/gesture_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/pillIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="pill"
            android:src="@drawable/ic_vol" />

        <ProgressBar
            android:id="@+id/pillBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="110dp"
            android:layout_height="6dp"
            android:layout_marginStart="10dp"
            android:max="100"
            android:progress="50"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="#FFFFFF" />
    </LinearLayout>

    <!-- ⏩ চেপে ধরে রাখলে 2x ফরওয়ার্ড প্লে -->
    <TextView
        android:id="@+id/pill2x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/gesture_pill_bg"
        android:drawableStart="@drawable/ic_speed"
        android:drawablePadding="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="2x"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- টেক্সট-হিন্ট (MX-স্টাইল) — (v3.6) রিয়েল আইকন + শুধু অঙ্ক; কোনো ইমোজি বা বাংলা শব্দ নেই -->
    <LinearLayout
        android:id="@+id/gestureHintBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hintIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="hint"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/gestureHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ⏮⏭ এপিসোড-সুইচের অ্যাড-গেট (v3.6) — প্লে-গেটের মতোই ৫ সেকেন্ডের কাউন্টডাউন -->
    <LinearLayout
        android:id="@+id/epGateBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/epGateMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="পরের এপিসোডে যাওয়ার আগে অ্যাড দেখো"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/epGateCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="5"
            android:textColor="#22C55E"
            android:textSize="44sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEpGateCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="বাতিল"
            android:textColor="#FFFFFF"
            app:backgroundTint="#33FFFFFF" />
    </LinearLayout>

    <!-- 🔒 লক-রো: বাঁ মাঝে লক-বাটন + "Tap to Lock" (রেফারেন্স-প্লেয়ারের মতো) -->
    <LinearLayout
        android:id="@+id/lockRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnMLock"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/player_btn_circle"
            android:contentDescription="lock"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap to Lock"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 🔒 লক থাকলে পুরো স্ক্রিন এই লেয়ার গিলে ফেলবে — কোনো ছোঁয়া কাজ করবে না -->
    <View
        android:id="@+id/lockLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- 🔓 আনলক — উপরের বাঁ কোণায়; লক করলেই শুধু এটা দেখা যাবে -->
    <ImageButton
        android:id="@+id/btnMUnlock"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/player_btn_circle"
        android:contentDescription="unlock"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_unlock"
        android:visibility="gone" />

    <!-- ⚠️ লোড ফেল হলে -->
    <LinearLayout
        android:id="@+id/errorBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="লোড হচ্ছে না"
            android:textColor="@color/textMain"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="আবার চেষ্টা করো" />

        <!-- সার্ভার ব্যস্ত থাকলে চ্যানেলে গিয়ে ওই ফাইল টেলিগ্রাম থেকে নেওয়া যায় -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrTg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="টেলিগ্রাম চ্যানেলে জয়েন করো"
            app:backgroundTint="#2293DC"
            app:icon="@drawable/ic_telegram"
            app:iconGravity="textStart" />
    </LinearLayout>
</FrameLayout>
