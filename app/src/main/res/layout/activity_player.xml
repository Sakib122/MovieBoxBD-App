<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_controller"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view" />

    <TextView
        android:id="@+id/gestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- ══ MX স্টাইল মেনু — উল্লম্ব পিল: 🔒 লক / ⚡ স্পিড / 🎧 অডিও / 💬 সাব / ⛶ স্ক্রিন ══
         ল্যান্ডস্কেপে বাঁ কিনারে, পোর্ট্রেটে ডান কিনারে (PlayerActivity.positionMxBar() ঠিক করে) —
         মাঝখানের প্লে/পজ বাটন বা মুভি কখনো ঢাকা পড়ে না -->
    <LinearLayout
        android:id="@+id/mxBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:background="@drawable/mx_bar_bg"
        android:orientation="vertical"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnMLock"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/player_btn_circle"
            android:gravity="center"
            android:text="🔒"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnMSpeed"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/player_btn_circle"
            android:gravity="center"
            android:text="1x"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMAudio"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/player_btn_circle"
            android:gravity="center"
            android:text="🎧"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnMSub"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/player_btn_circle"
            android:gravity="center"
            android:text="💬"
            android:textSize="16sp" />

        <!-- ⛶ স্ক্রিন মোড: ফিট → জুম (পুরো স্ক্রিন ভরে) → টানাটানি → ফিট -->
        <TextView
            android:id="@+id/btnMScale"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/player_btn_circle"
            android:gravity="center"
            android:text="⛶"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 🔒 লক থাকলে পুরো স্ক্রিন এই লেয়ার গিলে ফেলবে — কোনো ছোঁয়া কাজ করবে না -->
    <View
        android:id="@+id/lockLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- 🔓 আনলক — উপরের বাম কোণায় (MX Player-এর মতো); লক করলেই শুধু এটা দেখা যাবে -->
    <TextView
        android:id="@+id/btnMUnlock"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/player_btn_circle"
        android:gravity="center"
        android:text="🔓"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- ⚠️ লোড ফেল হলে -->
    <LinearLayout
        android:id="@+id/errorBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#B3000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⚠️ লোড হচ্ছে না"
            android:textColor="@color/textMain"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🔄 আবার চেষ্টা করো" />

        <!-- সার্ভার ব্যস্ত থাকলে চ্যানেলে গিয়ে ওই ফাইল টেলিগ্রাম থেকে নেওয়া যায় -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrTg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="✈️ টেলিগ্রাম চ্যানেলে জয়েন করো"
            app:backgroundTint="#2293DC" />
    </LinearLayout>
</FrameLayout>
