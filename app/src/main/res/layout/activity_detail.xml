<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ══ 🎬 মিনি-প্লেয়ার (রেফারেন্স-অ্যাপের মতো উপরে ছোট স্ক্রিন) ══ -->
        <FrameLayout
            android:id="@+id/playerBox"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:resize_mode="fit"
                app:show_buffering="when_playing"
                app:surface_type="surface_view"
                app:use_controller="false" />

            <!-- ▶ প্লে শুরুর আগে: পোস্টার + বড় প্লে-বাটন -->
            <FrameLayout
                android:id="@+id/posterCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000">

                <ImageView
                    android:id="@+id/dPosterTop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="poster"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient" />

                <ImageButton
                    android:id="@+id/btnMiniPlayBig"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="play"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:text="ট্যাপ করে দেখো"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- ↩ ব্যাক — আধুনিক গোল অর্ধ-স্বচ্ছ বাটন (প্লেয়ারের উপরে বাঁ কোণায়) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/player_btn_circle"
                android:contentDescription="back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <!-- ⏱ সিক-বার টানার সময় ভিডিওর মাঝে সময়-প্রিভিউ (রেফারেন্স-অ্যাপের মতো) -->
            <TextView
                android:id="@+id/seekPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#CC000000"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 🎛 মিনি-কন্ট্রোল: প্লে/পজ + টানা-যায় সিক-বার + সময় + ভলিউম + ⧉ ফ্লোট + ⛶ ফুলস্ক্রিন -->
            <LinearLayout
                android:id="@+id/miniCtrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/hero_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <ImageButton
                    android:id="@+id/btnMiniPlay"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="play"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/miniBar"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    app:bar_height="3dp"
                    app:buffered_color="#55FFFFFF"
                    app:played_color="#FFFFFF"
                    app:scrubber_color="#FFFFFF"
                    app:touch_target_height="26dp"
                    app:unplayed_color="#66FFFFFF" />

                <TextView
                    android:id="@+id/miniTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/btnVolDown"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/player_btn_circle"
                    android:contentDescription="volume down"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_vol_minus" />

                <ImageButton
                    android:id="@+id/btnVolUp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/player_btn_circle"
                    android:contentDescription="volume up"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_vol_plus" />

                <ImageButton
                    android:id="@+id/btnMiniFloat"
                    android:layout_width="38dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="floating popup"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_float" />

                <ImageButton
                    android:id="@+id/btnMiniMax"
                    android:layout_width="38dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="fullscreen"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fullscreen" />
            </LinearLayout>
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- টাইটেল + Info > -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/textMain"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/btnInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Info >"
                        android:textColor="@color/textSub"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/textSub"
                    android:textSize="12sp" />

                <!-- 🎛 অ্যাকশন চিপস: শেয়ার / ডাউনলোড / টেলিগ্রাম / ওয়েবসাইট -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnDlChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_download"
                            android:drawablePadding="6dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="9dp"
                            android:text="Download"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_share"
                            android:drawablePadding="6dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="9dp"
                            android:text="Share"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnTgChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_telegram"
                            android:drawablePadding="6dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="9dp"
                            android:text="Telegram"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnWebChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_globe"
                            android:drawablePadding="6dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="9dp"
                            android:text="Website"
                            android:textColor="@color/textMain"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- ✈️ টেলিগ্রাম চ্যানেল -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTgChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="টেলিগ্রাম চ্যানেলে জয়েন করো — নতুন মুভির আপডেট সবার আগে"
                    android:textSize="13sp"
                    app:backgroundTint="#2293DC"
                    app:icon="@drawable/ic_telegram"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

                <!-- 📼 স্ট্রিম লিংক না থাকলে এই কার্ডটা দেখাবে -->
                <LinearLayout
                    android:id="@+id/noVideoNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/note_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:alpha="0.85"
                        android:contentDescription="video"
                        android:src="@drawable/ic_video" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="এই ভিডিওটা অ্যাপে যোগ করা হয়নি!"
                        android:textColor="@color/textMain"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="চিন্তা নেই! এটা আমাদের ওয়েবসাইটে আপলোড করা আছে। নিচের বাটনে চাপলেই সরাসরি ওয়েবসাইটে যাবে — সেখানে এক ক্লিকেই দেখতে পারবে।"
                        android:textColor="@color/textSub"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNoteWeb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="ওয়েবসাইটে গিয়ে দেখো"
                        app:icon="@drawable/ic_globe"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNoteTg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="টেলিগ্রাম চ্যানেলে জয়েন করো"
                        app:backgroundTint="#2293DC"
                        app:icon="@drawable/ic_telegram"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- ══ 📚 Episodes / Quality — ড্রপ-চিপ + গ্রিড প্যানেল ══ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSeasonDrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:drawableEnd="@drawable/ic_drop"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp"
                        android:text="Season"
                        android:textColor="@color/textMain"
                        android:textSize="13sp" />

                    <!-- 🎧 ডুয়াল অডিও — সিজনের পাশেই Audio চিপ -->
                    <TextView
                        android:id="@+id/btnAudioDrop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:drawableStart="@drawable/ic_lang"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="9dp"
                        android:text="Audio"
                        android:textColor="@color/textMain"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Resources"
                        android:textColor="@color/textSub"
                        android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/linkChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="2dp" />
                </HorizontalScrollView>

                <!-- সিজন/এপিসোড গ্রিড প্যানেল (ড্রপ-চিপে ট্যাপ করলে খুলবে) -->
                <LinearLayout
                    android:id="@+id/seasonPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/note_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/seasonTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/textMain"
                            android:textSize="14sp" />

                        <ImageButton
                            android:id="@+id/btnPanelClose"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="close"
                            android:src="@drawable/ic_close" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/epGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <!-- ══ ⭐ For You — রেফারেন্সের মতো রিকমেন্ডেশন গ্রিড ══ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="For You"
                    android:textColor="@color/textMain"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/forYouGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <!-- 💰 300×250 অ্যাড — For You-র নিচে (প্লে করার পরই ইউজারের চোখে For You পড়ে) -->
                <FrameLayout
                    android:id="@+id/adBoxRect"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/surface">

                    <WebView
                        android:id="@+id/adRect"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 💰 নিচের ব্যানার অ্যাড -->
        <FrameLayout
            android:id="@+id/adBox2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/surface">

            <WebView
                android:id="@+id/adBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- 📥 ফ্লোটিং ডাউনলোড বাটন (রেফারেন্সের মতো নিচে-মাঝে সবুজ পিল) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFloatDl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="74dp"
        android:backgroundTint="@color/accent2"
        android:minWidth="160dp"
        android:paddingHorizontal="26dp"
        android:paddingVertical="14dp"
        android:text="Download"
        android:textColor="#0D0F1C"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_download"
        app:iconGravity="textStart"
        app:iconTint="#0D0F1C" />

    <!-- ══ ⏳ অ্যাড গেট ওভারলে (কাউন্টডাউন) ══ -->
    <LinearLayout
        android:id="@+id/gateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="gate"
            android:src="@drawable/ic_play" />

        <TextView
            android:id="@+id/gateMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="অ্যাড দেখা শেষ! প্লে শুরু হচ্ছে..."
            android:textColor="@color/textMain"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/gateCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="5"
            android:textColor="@color/accent"
            android:textSize="56sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="একটু অপেক্ষা করো — মুভি অটো প্লে হবে"
            android:textColor="@color/textSub"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGateCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="cancelGate"
            android:text="বাতিল করো"
            app:backgroundTint="@color/surface2" />
    </LinearLayout>
</FrameLayout>
