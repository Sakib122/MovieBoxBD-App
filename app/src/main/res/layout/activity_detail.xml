<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- উপরের বার -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/textMain" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="মুভি ডিটেইল"
                android:textColor="@color/textMain"
                android:textSize="18sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dPoster"
                        android:layout_width="120dp"
                        android:layout_height="180dp"
                        android:background="@color/surface2"
                        android:contentDescription="poster"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/dBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/accent"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/dTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/textMain"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/dMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/textSub"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="🎥 দেখো / ডাউনলোড করো"
                    android:textColor="@color/textMain"
                    android:textSize="15sp" />

                <!-- ⚠️ স্ট্রিম লিংক না থাকলে এই নোটিশ দেখাবে -->
                <TextView
                    android:id="@+id/noVideoNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface"
                    android:padding="12dp"
                    android:text="⚠️ এখানে দেখার মতো ভিডিও নেই। তবে নিচের ⬇ বাটনে চেপে টেলিগ্রাম থেকে ডাউনলোড করে দেখতে পারেন!"
                    android:textColor="#FFB74D"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/linkList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false" />

                <!-- 📜 ফাইল/এপিসোড ৪টার বেশি থাকলে এই বাটনে সুন্দর স্ক্রলেবল লিস্ট -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllLinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="📜 সবগুলো দেখো"
                    android:visibility="gone"
                    app:backgroundTint="@color/surface2"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/open_web"
                    app:backgroundTint="@color/surface2" />

                <!-- 💰 300×250 অ্যাড (তোমার Adsterra) -->
                <FrameLayout
                    android:id="@+id/adBoxRect"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/surface">

                    <WebView
                        android:id="@+id/adRect"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 💰 নিচের ব্যানার অ্যাড -->
        <FrameLayout
            android:id="@+id/adBox2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/surface">

            <WebView
                android:id="@+id/adBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- ══ ⏳ অ্যাড গেট ওভারলে (কাউন্টডাউন) ══ -->
    <LinearLayout
        android:id="@+id/gateOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/gateMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="অ্যাড দেখা শেষ! প্লে শুরু হচ্ছে..."
            android:textColor="@color/textMain"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/gateCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="5"
            android:textColor="@color/accent"
            android:textSize="56sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="একটু অপেক্ষা করো — মুভি অটো প্লে হবে 🍿"
            android:textColor="@color/textSub"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGateCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:onClick="cancelGate"
            android:text="✖ বাতিল করো"
            app:backgroundTint="@color/surface2" />
    </LinearLayout>
</FrameLayout>
