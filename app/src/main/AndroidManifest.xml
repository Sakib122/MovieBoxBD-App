<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 💓 (v5.5) অ্যাড-গেটের "১০ সেকেন্ড পূর্ণ" ভাইব্রেশন-সিগন্যাল — সাইলেন্ট মোডেও ইউজার টের পাবে -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 🛠 v2.6.1 বড় ফিক্স: Android 11+ (API 30+) এ নতুন "Package Visibility" রুল —
         এই <queries> ছাড়া অ্যাপটা MX Player / VLC ইনস্টল থাকলেও দেখতেই পায় না,
         ভাবে ইনস্টল নেই, তাই সাথে সাথে Play Store-এ নিয়ে যায়।
         এই ব্লক যোগ হলে ইনস্টল থাকলেই মুভি সরাসরি MX Player/VLC-তে খুলবে। -->
    <queries>
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.bsplayer.bspandroid.free" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:name=".MBXApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.MovieBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AdultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowLayoutInDisplayCutoutMode="shortEdges" />

        <!-- 💓 (v5.5) অ্যাড-গেটের ভাইব্রেশন-অ্যালার্ম (GateVibe) — অ্যাপ ব্যাকগ্রাউন্ডে
             থাকলেও / ফোন ডু মোডে থাকলেও ঠিক সময়ে জেগে একবার ভাইব্রেট করবে -->
        <receiver
            android:name=".GateVibeReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
